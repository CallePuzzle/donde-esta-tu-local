# Copia este fichero a .env y rellena los valores. Ver README.md para más detalle.

# PostgreSQL (o una URL de Prisma Accelerate, prisma+postgres://...)
DATABASE_URL=
# Conexión directa a PostgreSQL (sin Accelerate), usada por `directUrl` del
# esquema Prisma (migraciones e introspección). Puede ser la misma que
# DATABASE_URL si no usas Accelerate.
DIRECT_DATABASE_URL=

# better-auth (sesión/login OTP)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# SMTP para el código OTP de login (en dev no se envía email: el código
# queda en el log). Nótese el typo SMPT_ en vez de SMTP_: es intencionado,
# así está desplegado en producción.
SMTP_HOST=
SMPT_AUTH_USER=
SMPT_AUTH_PASS=
SMPT_SENDER=

# Vercel Blob, para subir el avatar del perfil
BLOB_READ_WRITE_TOKEN=
