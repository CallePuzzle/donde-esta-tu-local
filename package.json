{
	"name": "donde-esta-tu-local-v5",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"overrides": {
		"cookie": "^0.7.0",
		"yaml": "^1.10.3",
		"flatted": "^3.4.4",
		"tar": "^7.5.22",
		"postcss": "^8.5.25",
		"defu": "^6.1.7",
		"sharp": "^0.35.3",
		"validator": "^13.15.35",
		"rollup": "^4.62.4",
		"picomatch": "^4.0.5",
		"deepmerge-ts": "^8.0.0",
		"nanoid": "^3.3.18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "prisma generate && prisma migrate deploy && vite build",
		"only-build": "vite build",
		"preview": "bunx --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"paraglide-js": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"db:seed-activities": "bun prisma/seed-activities.ts",
		"db:seed-clear-activities": "bun prisma/seed-clear-activities.ts",
		"db:seed-test-notifications": "bun prisma/seed-test-notifications.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "bun run db:test:up && playwright test",
		"test:e2e:ui": "bun run db:test:up && playwright test --ui",
		"db:test:up": "podman compose up -d",
		"db:test:down": "podman compose stop postgres-test"
	},
	"lint-staged": {
		"**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue,astro,svelte}": "oxlint"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
