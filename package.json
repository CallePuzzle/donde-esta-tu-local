		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@sjmc11/tourguidejs": "^0.0.27",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/blob": "^2.8.0",
