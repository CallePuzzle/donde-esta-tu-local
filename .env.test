DIRECT_DATABASE_URL=postgresql://test:test@localhost:55433/e2e
BETTER_AUTH_SECRET=e2e-test-secret-no-usar-en-produccion-0123456789abcdef
BETTER_AUTH_URL=http://localhost:4174
SMTP_HOST=localhost
SMPT_AUTH_USER=test
SMPT_AUTH_PASS=test
SMPT_SENDER=test@example.com
BLOB_READ_WRITE_TOKEN=dummy
